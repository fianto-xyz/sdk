# fianto SDK — environment variables
# Copy to .env (or .env.local for Next.js) and fill in. Never commit real values.
# Server-side only: never expose these to the browser (no NEXT_PUBLIC_ / VITE_ prefix).
# @fianto/js and @fianto/react need none of them.

# Required — Dashboard → Applications → your app.
FIANTO_APP_ID=fian_app_xxxxxxxxxxxxxxxxxxxxxx
FIANTO_APP_SECRET=fian_sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — only if you receive webhooks.
# Dashboard → Applications → your app → Webhook → set your URL → "Reveal" the signing secret.
# Proves a webhook really came from fianto. Not the same as FIANTO_APP_SECRET.
FIANTO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
