# fianto SDK — environment variables

# ── API credentials (read by `new Fianto()`, the Checkout()/Webhooks() adapters and the CLI) ──
# From the fianto merchant dashboard → Applications.
FIANTO_APP_ID=fian_app_xxxxxxxxxxxxxxxxxxxxxx
FIANTO_APP_SECRET=fian_sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Backend base URL (optional) ──
# The origin of the fianto backend, WITHOUT /v1. Defaults to the production API
# (https://api.fianto.xyz) when unset. Override for devnet, self-hosting or a local backend.
# https:// is required; http:// is accepted only for localhost / 127.0.0.1 / [::1].
#   Local backend (pnpm start:dev):  http://localhost:3000
#   Deployed backend:                https://api.your-fianto-host.com
# FIANTO_BASE_URL=https://api.fianto.xyz  # default; set http://localhost:3000 for a local backend

# ── Webhooks (read by verifyWebhook(), Webhooks()/webhooks() and `fianto events tail`) ──
# The endpoint's signing secret, shown once in the dashboard when you set the webhook URL.
# During a secret roll you can pass both secrets in code: verifyWebhook(..., { secret: [oldSecret, newSecret] }).
FIANTO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Your own app config (used by the examples, not by the SDK) ──
# Price id(s) your checkout route maps plans to — decide prices on the server, never in the browser.
FIANTO_PRICE_PRO=fian_price_xxxxxxxxxxxxxxxxxxxxxx
# Port for the Express example server.
PORT=3100
