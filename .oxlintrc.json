{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "no-unused-vars": "error",
    "no-console": "off"
  },
  "overrides": [
    {
      "files": ["packages/sdk/src/**/*.ts", "packages/hono/src/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["node:*"], "message": "@fianto/sdk must stay runtime-neutral: use fetch/WebCrypto." }] }]
      }
    },
    {
      "files": ["packages/js/src/**/*.ts"],
      "excludeFiles": ["**/*.test.ts"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["node:*", "@fianto/sdk"], "message": "@fianto/js is browser-only: never import node:* or @fianto/sdk." }] }]
      }
    },
    {
      "files": ["packages/react/src/**/*.ts", "packages/react/src/**/*.tsx"],
      "excludeFiles": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": ["error", { "patterns": [{ "group": ["node:*", "@fianto/sdk"], "message": "@fianto/react is browser-only: never import node:* or @fianto/sdk." }] }]
      }
    }
  ]
}
