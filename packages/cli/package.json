{
  "name": "@fianto/cli",
  "version": "0.3.0",
  "description": "fianto command line: inspect events, forward webhooks to localhost, trigger and sign test events.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "fianto": "./dist/bin.js"
  },
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/fianto-xyz/sdk/issues"
  },
  "author": "fianto",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "webhooks",
    "cli"
  ],
  "scripts": {
    "prepack": "test -d dist || (echo 'dist/ is missing — run pnpm build first' >&2; exit 1)",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint"
  },
  "dependencies": {
    "@fianto/sdk": "workspace:^"
  }
}
