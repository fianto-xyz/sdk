{
  "name": "@fianto/express",
  "version": "0.2.0",
  "description": "Express middleware for fianto webhooks and checkout.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/express"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/express#readme",
  "bugs": {
    "url": "https://github.com/fianto-xyz/sdk/issues"
  },
  "author": "fianto",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "express",
    "middleware",
    "webhooks"
  ],
  "scripts": {
    "prepack": "test -d dist || (echo 'dist/ is missing — run pnpm build first' >&2; exit 1)",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint && attw --pack . --profile strict"
  },
  "dependencies": {
    "@fianto/sdk": "workspace:^"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "devDependencies": {
    "express": "5.2.1",
    "@types/express": "5.0.6",
    "express4": "npm:express@4.22.3"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
