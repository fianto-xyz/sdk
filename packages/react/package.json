{
  "name": "@fianto/react",
  "version": "0.1.0",
  "description": "React bindings for fianto: useCheckout() and the branded FiantoButton component.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/react#readme",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "checkout",
    "react",
    "button"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint && attw --pack . --profile strict"
  },
  "dependencies": {
    "@fianto/js": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
