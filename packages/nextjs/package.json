{
  "name": "@fianto/nextjs",
  "version": "0.1.0",
  "description": "Next.js App Router route handlers for fianto webhooks and checkout.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/nextjs#readme",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "nextjs",
    "app-router",
    "webhooks"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint && attw --pack . --profile node16"
  },
  "dependencies": {
    "@fianto/sdk": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=15"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
