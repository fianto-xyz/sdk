{
  "name": "@fianto/js",
  "version": "0.1.1",
  "description": "Browser SDK for fianto: open hosted checkout in a popup and the branded Pay with fianto button.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/button.*",
    "./dist/fianto-button.global.iife.js"
  ],
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/js#readme",
  "bugs": {
    "url": "https://github.com/fianto-xyz/sdk/issues"
  },
  "author": "fianto",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "checkout",
    "browser",
    "button"
  ],
  "scripts": {
    "prepack": "test -d dist || (echo 'dist/ is missing — run pnpm build first' >&2; exit 1)",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint && attw --pack . --profile strict"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./button": {
      "import": "./dist/button.js",
      "require": "./dist/button.cjs"
    },
    "./button-core": {
      "import": "./dist/button-core.js",
      "require": "./dist/button-core.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "button": ["./dist/button.d.cts"],
      "button-core": ["./dist/button-core.d.cts"]
    }
  }
}
