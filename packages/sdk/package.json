{
  "name": "@fianto/sdk",
  "version": "0.1.0",
  "description": "Server-side SDK for fianto: typed API client, webhook verification and route handlers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/sdk#readme",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "checkout",
    "webhooks",
    "sdk"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint && attw --pack . --profile node16"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./handlers": {
      "import": "./dist/handlers.js",
      "require": "./dist/handlers.cjs"
    },
    "./webhooks": {
      "import": "./dist/webhooks.js",
      "require": "./dist/webhooks.cjs"
    },
    "./package.json": "./package.json"
  }
}
