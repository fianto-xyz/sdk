{
  "name": "@fianto/hono",
  "version": "0.1.0",
  "description": "Hono handlers for fianto webhooks and checkout (Workers, Bun, Deno, Node).",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fianto-xyz/sdk.git",
    "directory": "packages/hono"
  },
  "homepage": "https://github.com/fianto-xyz/sdk/tree/master/packages/hono#readme",
  "bugs": {
    "url": "https://github.com/fianto-xyz/sdk/issues"
  },
  "author": "fianto",
  "keywords": [
    "fianto",
    "solana",
    "usdc",
    "payments",
    "hono",
    "cloudflare-workers",
    "webhooks"
  ],
  "scripts": {
    "prepack": "test -d dist || (echo 'dist/ is missing — run pnpm build first' >&2; exit 1)",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "check": "publint && attw --pack . --profile strict"
  },
  "dependencies": {
    "@fianto/sdk": "workspace:^"
  },
  "peerDependencies": {
    "hono": ">=4"
  },
  "devDependencies": {
    "hono": "4.13.9"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  }
}
