# Copy to .env.local and fill in from your fianto dashboard. Never commit real values.

# Server-side only — never exposed to the browser.
FIANTO_APP_ID=
FIANTO_APP_SECRET=

# Optional: defaults to the production API (https://api.fianto.xyz) when unset. Point this at
# your own backend for local development or self-hosting — there is no separate "devnet" API
# host to switch to.
# FIANTO_BASE_URL=https://api.fianto.xyz  # default; set http://localhost:3000 for a local backend

# The signing secret for the endpoint you register at /api/webhooks/fianto.
FIANTO_WEBHOOK_SECRET=

# The id of the recurring Price backing the "pro" plan (see app/api/checkout/route.ts).
FIANTO_PRICE_PRO=

# This app's own public origin, used to build success_url/cancel_url — required (https://) once
# deployed; falls back to the incoming request's own origin (works for local dev only) if unset.
# SITE_URL=https://shop.example
