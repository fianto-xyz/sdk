# Copy to .env and fill in from your fianto dashboard. Never commit real values.

# Server-side only — never exposed to the browser.
FIANTO_APP_ID=
FIANTO_APP_SECRET=

# Mainnet and devnet are separate deployments with no default: point this at whichever one
# these credentials belong to.
FIANTO_BASE_URL=

# The signing secret for the endpoint you register at /webhooks/fianto.
FIANTO_WEBHOOK_SECRET=

# The id of a recurring Price, if you adapt this example's "pro" plan to a subscription.
FIANTO_PRICE_PRO=

# Optional: the port this server listens on (default 3100).
PORT=
