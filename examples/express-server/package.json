  "dependencies": {
    "@fianto/express": "workspace:^",
    "@fianto/js": "workspace:^",
    "@fianto/sdk": "workspace:^",
    "express": "5.2.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
